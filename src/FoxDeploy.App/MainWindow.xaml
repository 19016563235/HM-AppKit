<Window x:Class="FoxDeploy.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="HM AppKit" Icon="Assets/HM-AppKit.ico" Width="1010" Height="680" MinWidth="1010" MinHeight="680" WindowState="Normal" WindowStartupLocation="CenterScreen" Closing="Window_Closing" UseLayoutRounding="True" Style="{StaticResource {x:Type Window}}">
  <Grid Margin="20,14,20,14">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Margin="1,0,1,11">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Image Source="Assets/HM-AppKit.png" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="HM AppKit" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" /><Button x:Name="SelfUpdateCheckButton" Content="检查更新" Click="SelfUpdateCheck_Click" Style="{StaticResource QuietButton}" FontSize="10" Margin="10,1,0,0" Padding="5,4" VerticalAlignment="Center" /></StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="WingetStatus" Visibility="Collapsed" Foreground="#98A2B3" FontSize="10" Margin="0,0,12,0" VerticalAlignment="Center" /><Button x:Name="AdminButton" Content="管理员运行" Click="Admin_Click" Padding="10,5" FontSize="11" Background="Transparent" ToolTip="以管理员身份重新打开，便于需要提权的安装。" /></StackPanel>
      <Border x:Name="SelfUpdateBanner" Grid.Row="1" Grid.ColumnSpan="3" Visibility="Collapsed" Background="#F3F5F8" BorderBrush="#DDE2EB" BorderThickness="1" CornerRadius="9" Margin="0,13,0,0" Padding="12,9">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,10,0"><TextBlock x:Name="SelfUpdateTitle" FontWeight="SemiBold" FontSize="11" /><TextBlock x:Name="SelfUpdateHint" Foreground="#718096" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" /></StackPanel>
          <Button x:Name="SelfUpdateActionButton" Grid.Column="1" Content="下载更新" Click="SelfUpdateAction_Click" Style="{StaticResource PrimaryButton}" FontSize="10" Padding="12,7" VerticalAlignment="Center" />
          <Button x:Name="SelfUpdateDismissButton" Grid.Column="2" Content="稍后" Click="SelfUpdateDismiss_Click" Style="{StaticResource QuietButton}" FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center" />
          <ProgressBar x:Name="SelfUpdateDownloadProgress" Grid.Row="1" Grid.ColumnSpan="3" Visibility="Collapsed" Height="3" Margin="0,8,0,0" Minimum="0" Maximum="100" Foreground="{StaticResource Accent}" BorderThickness="0" Background="#E7EBF1" />
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="250" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="安装到" FontSize="11" Foreground="#7E899B" VerticalAlignment="Center" Margin="0,0,11,0" />
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,12,0"><ItemsControl x:Name="DriveCards"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Click="Drive_Click" Tag="{Binding Letter}" Background="{Binding Background}" BorderBrush="{Binding BorderColor}" Padding="10,5" Margin="0,0,7,0" MinWidth="108" HorizontalContentAlignment="Left" ToolTip="{Binding Tooltip}"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{Binding TextColor}" FontSize="13" /><TextBlock Text="{Binding FreeText}" Foreground="#8B97AB" FontSize="9.5" Margin="0,2,0,0" /></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        <Border Grid.Column="2" BorderBrush="#EDF0F5" BorderThickness="1,0,0,0" Padding="12,0,8,0"><Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="目录" FontSize="10" Foreground="#939DB0" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock x:Name="RootPathText" Grid.Column="1" Text="Software" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" /><Button x:Name="EditRootButton" Grid.Column="2" Click="EditRoot_Click" Style="{StaticResource EditIconButton}" Margin="5,0,0,0" VerticalAlignment="Center" ToolTip="编辑安装根目录" AutomationProperties.Name="编辑安装根目录" /></Grid></Border>
        <Button x:Name="AutoDriveButton" Grid.Column="3" Content="默认" Click="AutoDrive_Click" Style="{StaticResource QuietButton}" FontSize="10" Padding="6,5" VerticalAlignment="Center" />
        <Button x:Name="RefreshDrivesButton" Grid.Column="4" Content="刷新" Click="RefreshDrives_Click" Style="{StaticResource QuietButton}" FontSize="10" Padding="6,5" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <Border Grid.Row="2" Style="{StaticResource Card}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" x:Name="RoleButtons" VerticalAlignment="Center" Margin="13,8,13,5"><Button Content="公共" Tag="公共" Click="Role_Click" Padding="13,6" Margin="0,0,3,0" BorderThickness="0" /><Button Content="运营" Tag="运营" Click="Role_Click" Padding="13,6" Margin="0,0,3,0" BorderThickness="0" /><Button Content="客服" Tag="客服" Click="Role_Click" Padding="13,6" Margin="0,0,3,0" BorderThickness="0" /><Button Content="短视频" Tag="短视频" Click="Role_Click" Padding="13,6" Margin="0,0,3,0" BorderThickness="0" /><Button Content="全部" Tag="全部" Click="Role_Click" Padding="13,6" Margin="0,0,3,0" BorderThickness="0" /><Button x:Name="CustomRoleButton" Content="自定义" Tag="自定义" Click="Role_Click" Padding="13,6" BorderThickness="0" Visibility="Collapsed" /></StackPanel>
        <Grid Grid.Row="1" Margin="17,0,13,7"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="185" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"><Grid x:Name="SelectionSummarySlot" VerticalAlignment="Center"><TextBlock x:Name="SelectionSummaryMeasure" Text="已选择 9999 个应用" FontSize="11" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Visibility="Hidden" IsHitTestVisible="False" /><TextBlock x:Name="SelectionSummary" Text="已选择 0 个应用" FontSize="11" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Left" /></Grid><Button x:Name="SelectVisibleButton" Content="全选" Click="SelectVisible_Click" Style="{StaticResource QuietButton}" Padding="8,4" FontSize="11" Margin="9,0,0,0" /><Button x:Name="ClearSelectionButton" Content="清空" Click="ClearSelection_Click" Style="{StaticResource QuietButton}" Padding="7,4" FontSize="11" /></StackPanel><Grid Grid.Column="1" Margin="8,0,0,0">
          <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" ToolTip="搜索应用" FontSize="11" Padding="11,0" Height="32" VerticalContentAlignment="Center" Background="#F8F9FC" BorderThickness="0" />
          <TextBlock Text="搜索应用" Foreground="#9AA6B7" IsHitTestVisible="False" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="11">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Text, ElementName=SearchBox}" Value="" /><Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
        </Grid><Button x:Name="AddCustomButton" Grid.Column="2" Content="＋ 添加" Click="AddCustom_Click" Margin="9,0,0,0" Padding="10,7" FontSize="11" /></Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8,0,8,7">
          <ItemsControl x:Name="AppItems" VerticalAlignment="Top">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border CornerRadius="9" BorderThickness="1" Padding="10,7" Margin="4" MinHeight="60" ToolTip="{Binding CapabilitiesHint}">
                  <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#E9EDF4" /><Style.Triggers><DataTrigger Binding="{Binding Selected}" Value="True"><Setter Property="Background" Value="#F6F7F9" /><Setter Property="BorderBrush" Value="#C6CEDF" /></DataTrigger></Style.Triggers></Style></Border.Style>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid Margin="0,0,5,0" VerticalAlignment="Center">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /></Grid.ColumnDefinitions>
                      <Grid Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border CornerRadius="7" Background="{Binding IconBackground}">
                          <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Logo}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                          <TextBlock Text="{Binding Initial}" Foreground="{Binding IconColor}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <Image Source="{Binding Logo}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                      </Grid>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Text="{Binding App.Name}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="130" VerticalAlignment="Center" ToolTip="{Binding App.Name}" />
                          <Border Background="{Binding InstallModeBackground}" CornerRadius="4" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding InstallModeLabel}" Foreground="{Binding InstallModeColor}" FontSize="8.5" ToolTip="{Binding SilentLabel}" /></Border>
                        </StackPanel>
                        <TextBlock Text="{Binding DisplayPath}" Foreground="{Binding PathColor}" FontSize="9" TextTrimming="CharacterEllipsis" ToolTip="{Binding PathHint}" Margin="0,5,0,0" />
                      </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="BrowsePath_Click" Tag="{Binding}" IsEnabled="{Binding IsEditable}" Style="{StaticResource EditIconButton}" VerticalAlignment="Center" ToolTip="编辑此应用的安装目录" AutomationProperties.Name="{Binding App.Name, StringFormat='编辑 {0} 的安装目录'}" Margin="0,0,4,0" />
                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" Style="{StaticResource AppSelectionDot}" VerticalAlignment="Center" ToolTip="选择此应用" AutomationProperties.Name="{Binding App.Name, StringFormat='选择 {0}'}" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,1,0,0" ToolTip="{Binding StatusMessage}"><Ellipse Width="5" Height="5" Fill="{Binding StatusDotColor}" VerticalAlignment="Center" Margin="0,0,4,0" /><TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="8" VerticalAlignment="Center" /></StackPanel>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
    <Grid Grid.Row="3" Margin="2,5,2,0"><Expander x:Name="LogExpander" Header="日志" Foreground="#8A96A9" FontSize="10"><Border Style="{StaticResource Card}" Padding="7" Margin="0,5,0,0"><TextBox x:Name="LogBox" Height="85" VerticalContentAlignment="Top" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#F8FAFD" BorderThickness="0" FontFamily="Consolas, Microsoft YaHei UI" FontSize="10" Padding="7" /></Border></Expander><Button Content="打开目录 ↗" Click="OpenLogs_Click" Style="{StaticResource QuietButton}" Padding="2,3" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="打开日志文件夹" AutomationProperties.Name="打开日志文件夹" /></Grid>
    <Grid Grid.Row="4" Margin="2,8,2,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><CheckBox x:Name="SkipInstalledCheck" Content="跳过已安装" IsChecked="True" Click="Settings_Changed" Style="{StaticResource IosSwitch}" FontSize="11" Margin="0,0,22,0" /><CheckBox x:Name="SilentCheck" Content="静默安装" IsChecked="True" Click="Settings_Changed" Style="{StaticResource IosSwitch}" FontSize="11" ToolTip="支持的安装包优先静默；京麦等使用常规安装并预填目录，仍需确认向导。" /></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="StopButton" Content="完成当前后停止" Click="Stop_Click" Visibility="Collapsed" Margin="0,0,8,0" Padding="11,11" FontSize="11" /><Button x:Name="InstallButton" Content="一键安装" Click="Install_Click" Style="{StaticResource PrimaryButton}" Padding="30,11" FontSize="12" /></StackPanel>
      <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,9,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="RunStatus" Text="就绪" FontSize="10" Foreground="#8D98AA" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
        <TextBlock x:Name="RunProgressSummary" Grid.Column="1" Text="总体进度 0%" FontSize="10" Foreground="#7E899B" VerticalAlignment="Center" ToolTip="按已有最终结果的应用计数；失败、取消及目录待处理项也计入，不代表安装成功率或下载进度。" AutomationProperties.Name="总体队列进度及已结束应用数" />
      </Grid>
      <TextBlock x:Name="RunHint" Visibility="Collapsed" />
      <ProgressBar x:Name="RunProgress" Grid.Row="2" Grid.ColumnSpan="2" Height="8" Margin="0,7,0,0" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource Accent}" Background="#E3E7EF" BorderThickness="0" ToolTip="总体队列进度：已结束项数 ÷ 本次应用总数；不代表安装成功率或下载进度。" AutomationProperties.Name="总体安装进度">
        <ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4"><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left" /></Border></ControlTemplate></ProgressBar.Template>
      </ProgressBar>
    </Grid>
  </Grid>
</Window>
