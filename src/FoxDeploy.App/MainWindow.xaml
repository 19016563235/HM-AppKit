<Window x:Class="FoxDeploy.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="HM AppKit" Icon="Assets/HM-AppKit.ico" Width="1140" Height="810" MinWidth="1010" MinHeight="680" WindowStartupLocation="CenterScreen" Closing="Window_Closing" UseLayoutRounding="True" Style="{StaticResource {x:Type Window}}">
  <Grid Margin="30,25,30,23">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Margin="1,0,1,21">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Image Source="Assets/HM-AppKit.png" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
      <StackPanel Grid.Column="1"><TextBlock Text="HM AppKit" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="为工作电脑准备好每一款应用" Style="{StaticResource Caption}" Margin="0,5,0,0" /></StackPanel>
      <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="AdminButton" Content="管理员运行" Click="Admin_Click" Padding="11,6" FontSize="11" Background="Transparent" HorizontalAlignment="Right" /><TextBlock x:Name="WingetStatus" Text="正在检查安装源…" Foreground="#98A2B3" FontSize="10" Margin="0,7,1,0" TextAlignment="Right" /></StackPanel>
    </Grid>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,14,18,12" Margin="0,0,0,15">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,11"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="安装位置" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" /><Button x:Name="AutoDriveButton" Grid.Column="2" Content="默认" Click="AutoDrive_Click" Style="{StaticResource QuietButton}" /><Button x:Name="RefreshDrivesButton" Grid.Column="3" Content="刷新" Click="RefreshDrives_Click" Style="{StaticResource QuietButton}" /></Grid>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,20,0"><ItemsControl x:Name="DriveCards"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Click="Drive_Click" Tag="{Binding Letter}" Background="{Binding Background}" BorderBrush="{Binding BorderColor}" Padding="12,9" Margin="0,0,8,3" MinWidth="120" HorizontalContentAlignment="Left" ToolTip="{Binding Tooltip}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{Binding TextColor}" FontSize="15" /><TextBlock Text="{Binding FreeText}" Foreground="#8B97AB" FontSize="10" Margin="0,4,0,0" /></StackPanel></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
          <Border Grid.Column="1" BorderBrush="#EDF0F5" BorderThickness="1,0,0,0" Padding="20,0,0,0" MinWidth="230"><StackPanel VerticalAlignment="Center"><TextBlock Text="安装根目录" FontSize="10" Foreground="#939DB0" /><Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="RootPathText" Text="Software" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="210" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" /><Button x:Name="EditRootButton" Grid.Column="1" Content="修改" Click="EditRoot_Click" Style="{StaticResource QuietButton}" Foreground="#4366E9" Padding="10,5,0,5" Margin="10,0,0,0" /></Grid></StackPanel></Border>
        </Grid>
      </Grid>
    </Border>
    <Border Grid.Row="2" Style="{StaticResource Card}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Margin="15,13,15,11"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="165" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" x:Name="RoleButtons" VerticalAlignment="Center"><Button Content="公共" Tag="公共" Click="Role_Click" Padding="13,7" Margin="0,0,3,0" BorderThickness="0" /><Button Content="运营" Tag="运营" Click="Role_Click" Padding="13,7" Margin="0,0,3,0" BorderThickness="0" /><Button Content="客服" Tag="客服" Click="Role_Click" Padding="13,7" Margin="0,0,3,0" BorderThickness="0" /><Button Content="短视频" Tag="短视频" Click="Role_Click" Padding="13,7" Margin="0,0,3,0" BorderThickness="0" /><Button Content="全部" Tag="全部" Click="Role_Click" Padding="13,7" Margin="0,0,3,0" BorderThickness="0" /><Button x:Name="CustomRoleButton" Content="自定义" Tag="自定义" Click="Role_Click" Padding="13,7" BorderThickness="0" Visibility="Collapsed" /></StackPanel><Grid Grid.Column="1" Margin="8,0,0,0">
          <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" ToolTip="搜索应用" FontSize="11" Padding="11,0" Height="32" VerticalContentAlignment="Center" Background="#F8F9FC" BorderThickness="0" />
          <TextBlock Text="搜索应用" Foreground="#9AA6B7" IsHitTestVisible="False" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="11">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Text, ElementName=SearchBox}" Value="" /><Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
        </Grid><Button x:Name="AddCustomButton" Grid.Column="2" Content="＋ 添加" Click="AddCustom_Click" Margin="9,0,0,0" Padding="10,7" FontSize="11" /></Grid>
        <Grid Grid.Row="1" Margin="20,0,20,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="安装来源" FontSize="10" Foreground="#97A1B2" VerticalAlignment="Center" Margin="0,0,11,0" /><Border Grid.Column="1" Background="#F3F5F9" CornerRadius="7" Padding="2"><StackPanel x:Name="SourceChoice" Orientation="Horizontal"><Button x:Name="OnlineSourceButton" Content="在线最新版" Tag="Online" Click="SourceMode_Click" Padding="9,5" FontSize="10" BorderThickness="0" /><Button x:Name="LocalSourceButton" Content="本地安装包" Tag="Local" Click="SourceMode_Click" Padding="9,5" FontSize="10" BorderThickness="0" /></StackPanel></Border><TextBlock x:Name="SourceHint" Grid.Column="2" Text="从官方渠道获取" FontSize="10" Foreground="#97A1B2" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" /><Button x:Name="PackageDirectoryButton" Grid.Column="3" Content="选择安装包目录" Click="PackageDirectory_Click" Style="{StaticResource QuietButton}" Foreground="#4366E9" FontSize="10" Padding="6,4" Visibility="Collapsed" /></Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="9,0,9,9">
          <ItemsControl x:Name="AppItems" VerticalAlignment="Top">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border CornerRadius="9" BorderThickness="1" Padding="10,6" Margin="4" MinHeight="60" ToolTip="{Binding CapabilitiesHint}">
                  <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#E9EDF4" /><Style.Triggers><DataTrigger Binding="{Binding Selected}" Value="True"><Setter Property="Background" Value="#F6F8FF" /><Setter Property="BorderBrush" Value="#C8D3F8" /></DataTrigger></Style.Triggers></Style></Border.Style>
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition Height="14" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid Margin="0,0,7,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /></Grid.ColumnDefinitions>
                      <Grid Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border CornerRadius="7" Background="{Binding IconBackground}">
                          <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Logo}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                          <TextBlock Text="{Binding Initial}" Foreground="{Binding IconColor}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <Image Source="{Binding Logo}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                      </Grid>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="{Binding App.Name}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SourceLabel}" Foreground="{Binding SourceColor}" FontSize="8.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceHint}" Margin="0,2,0,0" />
                      </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                      <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" HorizontalAlignment="Right" />
                      <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="8" ToolTip="{Binding StatusMessage}" HorizontalAlignment="Right" Margin="0,3,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding DisplayPath}" Foreground="{Binding PathColor}" FontSize="8.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding PathHint}" Margin="0,0,6,0" />
                    <Button Grid.Row="1" Grid.Column="1" Content="修改" Click="BrowsePath_Click" Tag="{Binding}" IsEnabled="{Binding IsEditable}" Style="{StaticResource QuietButton}" Foreground="#6A7CA8" Padding="1,0" FontSize="8.5" VerticalAlignment="Center" HorizontalAlignment="Right" ToolTip="修改此应用的安装目录" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
    <Expander x:Name="LogExpander" Grid.Row="3" Header="安装日志" Margin="2,11,2,0" Foreground="#8A96A9" FontSize="10"><Border Style="{StaticResource Card}" Padding="10" Margin="0,7,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="110" /></Grid.RowDefinitions><Button Content="打开日志目录 ↗" Click="OpenLogs_Click" Style="{StaticResource QuietButton}" Padding="1" FontSize="10" HorizontalAlignment="Right" /><TextBox x:Name="LogBox" Grid.Row="1" VerticalContentAlignment="Top" Margin="0,6,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#F8FAFD" BorderThickness="0" FontFamily="Consolas, Microsoft YaHei UI" FontSize="10" Padding="8" /></Grid></Border></Expander>
    <Grid Grid.Row="4" Margin="2,15,2,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock x:Name="SelectionSummary" Text="已选择 0 个应用" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" /><Button x:Name="SelectVisibleButton" Content="全选" Click="SelectVisible_Click" Style="{StaticResource QuietButton}" Padding="9,0" FontSize="10" Margin="10,0,0,0" /><Button x:Name="ClearSelectionButton" Content="清空" Click="ClearSelection_Click" Style="{StaticResource QuietButton}" Padding="5,0" FontSize="10" /></StackPanel><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><CheckBox x:Name="SkipInstalledCheck" Content="跳过已安装" IsChecked="True" Click="Settings_Changed" FontSize="10" Margin="0,0,18,0" /><CheckBox x:Name="SilentCheck" Content="静默安装" IsChecked="True" Click="Settings_Changed" FontSize="10" Margin="0,0,18,0" ToolTip="支持的安装包优先静默；京麦等使用常规安装并预填目录，仍需确认向导。" /><CheckBox x:Name="KeepInstallersCheck" Content="保留安装包" IsChecked="True" Click="Settings_Changed" FontSize="10" ToolTip="保留已下载并校验的安装包到程序旁 Local Installer 文件夹，便于下次复用。" /></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="StopButton" Content="完成当前后停止" Click="Stop_Click" Visibility="Collapsed" Margin="0,0,8,0" Padding="11,11" FontSize="11" /><Button x:Name="PreviewButton" Content="安装预览" Click="Preview_Click" Margin="0,0,9,0" Padding="16,11" FontSize="12" Background="Transparent" /><Button x:Name="InstallButton" Content="一键安装" Click="Install_Click" Style="{StaticResource PrimaryButton}" Padding="30,11" FontSize="12" /></StackPanel><TextBlock x:Name="RunStatus" Grid.Row="1" Grid.ColumnSpan="2" Text="准备就绪" FontSize="10" Foreground="#8D98AA" Margin="0,13,0,0" TextWrapping="Wrap" /><TextBlock x:Name="RunHint" Visibility="Collapsed" /><ProgressBar x:Name="RunProgress" Grid.Row="2" Grid.ColumnSpan="2" Height="3" Margin="0,9,0,0" Minimum="0" Maximum="100" Value="0" Foreground="#4366E9" Background="#E7EBF3" BorderThickness="0" /></Grid>
  </Grid>
</Window>
