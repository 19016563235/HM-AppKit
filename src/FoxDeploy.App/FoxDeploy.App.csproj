<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HM AppKit</AssemblyName>
    <RootNamespace>FoxDeploy.App</RootNamespace>
    <Title>HM AppKit</Title>
    <Description>按岗位批量安装 Windows 应用</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/HM-AppKit.ico</ApplicationIcon>
    <SupportReceiverBundlePath Condition="'$(SupportReceiverBundlePath)' == ''">$(MSBuildProjectDirectory)/obj/support/hm-support.bin</SupportReceiverBundlePath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FoxDeploy.Core/FoxDeploy.Core.csproj" />
    <Content Include="../../catalog/catalog.json" Link="Data/catalog.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="../../catalog/catalog.json" LogicalName="FoxDeploy.catalog.json" />
    <Resource Include="Assets/AppIcons/*.png" />
    <Resource Include="Assets/HM-AppKit.png" />
    <Resource Include="Assets/HM-AppKit.ico" />
  </ItemGroup>
  <!-- Added at target execution time, after Build.ps1 has generated the ignored
       bundle. The resource is embedded only; it is not copied beside the EXE. -->
  <Target Name="IncludeBuiltInSupportReceiver" BeforeTargets="AssignTargetPaths">
    <ItemGroup Condition="Exists('$(SupportReceiverBundlePath)')">
      <EmbeddedResource Include="$(SupportReceiverBundlePath)" LogicalName="FoxDeploy.support-receiver.bin" />
    </ItemGroup>
  </Target>
</Project>
